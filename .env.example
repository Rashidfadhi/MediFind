# MySQL connection string; URL-encode special characters in the password.
MEDIFIND_DATABASE_URL=mysql+pymysql://medifind:change-me@localhost:3306/medifind

# Generate a unique random value with: python -c "import secrets; print(secrets.token_urlsafe(48))"
MEDIFIND_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
MEDIFIND_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Set true when serving the website over HTTPS.
MEDIFIND_COOKIE_SECURE=false
